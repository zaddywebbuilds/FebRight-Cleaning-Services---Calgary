# Copy this file to `.env` and fill in real values.

# Formspree endpoint for the quote request form.
# 1. Create a free form at https://formspree.io
# 2. Copy the endpoint URL it gives you (looks like https://formspree.io/f/xxxxxxxx)
# 3. Paste it below and restart the dev server.
# Until this is set, the form falls back to opening the visitor's email client.
VITE_FORMSPREE_ENDPOINT=

# Base path for GitHub Pages deployment under a subdirectory.
# Leave unset for a root-domain deploy. Example for a project page: /febright/
VITE_BASE_PATH=
